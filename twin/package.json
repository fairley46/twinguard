{
  "name": "twinguard",
  "private": true,
  "version": "0.1.0",
  "description": "TwinGuard — Kubernetes-first infrastructure digital twin. Simulate before you ship.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/terraform",
    "packages/mcp"
  ],
  "scripts": {
    "build": "npm run -ws build",
    "test": "node --test test/analyze.test.mjs",
    "analyze": "tsx apps/api/src/cli.ts analyze",
    "report": "tsx apps/api/src/cli.ts report",
    "watch": "tsx apps/api/src/watch.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
